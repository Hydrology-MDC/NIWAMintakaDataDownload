api:
  base_url: "https://mintaka.niwa.co.nz/rest/api"
  api_credential: "mintaka_api"

folders:
  raw: "output/raw"
  csv: "output/csv"

state:
  file: "state/last_run.json"

logging:
  file: "logs/NIWA_Mintaka_Climate.log"
  level: "INFO"

products:
